# Paste ONLY the .ROBLOSECURITY cookie value from your own browser.
# This cookie is a full login to your Roblox account. Never commit it,
# never send it to anyone, and never paste it into a chat.
ROBLOSECURITY=

# Optional. Posts outfit swaps, bio changes, and rate limits.
# Anyone with this URL can post into that Discord channel. Never commit it.
DISCORD_WEBHOOK_URL=

# Optional. Badge removals go here instead of the main webhook.
DISCORD_BADGE_WEBHOOK_URL=
